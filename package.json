{
  "name": "devin-paperclip-adapter",
  "version": "1.0.1",
  "description": "Paperclip agent adapter that runs the Devin CLI as a local process.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qoyyuum/devin-paperclip-adapter.git"
  },
  "type": "module",
  "keywords": [
    "paperclip",
    "paperclip-adapter",
    "devin",
    "devin-cli",
    "ai-agent",
    "agent-adapter"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./ui-parser": {
      "types": "./dist/ui-parser.d.ts",
      "default": "./dist/ui-parser.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@paperclipai/adapter-utils": "^2026.1023.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
